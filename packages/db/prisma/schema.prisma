// =============================================================================
// VELORA — Prisma schema (Phase 1)
// -----------------------------------------------------------------------------
// One database serves four business models that share a single graph:
//   social (posts, reels, stories, DMs) · discovery (boards, embeddings)
//   quick commerce (dark stores, riders) · marketplace (sellers, orders)
//
// Conventions
//   · Money is stored as integer minor units (paise) — never floats.
//   · Every user-facing content row carries denormalised counters so feeds can
//     be rendered without aggregate queries (reconciled by a nightly job).
//   · Embeddings are pgvector columns; they are written by the AI worker via
//     raw SQL because Prisma cannot write `Unsupported` columns.
//   · Polymorphic links (reports, analytics, risk signals) use
//     `subjectType` + `subjectId` strings on purpose — they must not cascade
//     deletes from unrelated tables.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// =============================================================================
// Identity & access
// =============================================================================

enum Role {
  USER
  CREATOR
  SELLER
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String?
  name         String
  handle       String     @unique
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  isVerified   Boolean    @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  addresses          Address[]
  membership         Membership?
  seller             Seller?
  creator            CreatorProfile?
  rider              Rider?
  posts              Post[]
  stories            Story[]
  storyViews         StoryView[]
  comments           Comment[]
  commentLikes       CommentLike[]
  postLikes          PostLike[]
  savedPosts         SavedPost[]
  boards             Board[]
  boardMemberships   BoardCollaborator[]
  boardItemsAdded    BoardItem[]               @relation("BoardItemAddedBy")
  cart               Cart[]
  orders             Order[]
  reviews            Review[]
  wishlist           WishlistItem[]
  conversations      ConversationParticipant[]
  messages           Message[]
  notifications      Notification[]            @relation("NotificationRecipient")
  notificationsSent  Notification[]            @relation("NotificationActor")
  followers          Follow[]                  @relation("FollowFollower")
  following          Follow[]                  @relation("FollowFollowing")
  payouts            Payout[]
  assistantThreads   AssistantThread[]
  visualSearches     VisualSearchRequest[]
  reorderSuggestions ReorderSuggestion[]
  analyticsEvents    AnalyticsEvent[]
  feedImpressions    FeedImpression[]
  searchQueries      SearchQuery[]
  reportsFiled       Report[]                  @relation("ReportReporter")
  reportsModerated   Report[]                  @relation("ReportModerator")
  auditLogs          AdminAuditLog[]
  couponRedemptions  CouponRedemption[]
  returnRequests     ReturnRequest[]
  pushTokens         PushToken[]

  @@index([role, status])
  @@index([handle])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String // "google" | "apple" ...
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String   @default("Home")
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  pincode       String
  country       String   @default("IN")
  lat           Float?
  lng           Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MembershipTier {
  PLUS
  PLUS_STUDIO
}

enum MembershipStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Prime-style paid membership: free quick delivery, faster marketplace shipping.
model Membership {
  id          String           @id @default(cuid())
  userId      String           @unique
  tier        MembershipTier   @default(PLUS)
  status      MembershipStatus @default(ACTIVE)
  startedAt   DateTime         @default(now())
  renewsAt    DateTime?
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  actorId    String?
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MENTION
  ORDER_UPDATE
  DELIVERY_UPDATE
  PRICE_DROP
  RESTOCK
  PAYOUT
  MODERATION
  SYSTEM
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// =============================================================================
// Catalogue: sellers, products, variants, reviews, pricing
// =============================================================================

enum SellerStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  BLOCKED
}

model Seller {
  id            String       @id @default(cuid())
  userId        String       @unique
  storeName     String
  slug          String       @unique
  description   String?
  logoUrl       String?
  rating        Float        @default(0)
  ratingCount   Int          @default(0)
  status        SellerStatus @default(PENDING)
  commissionBps Int          @default(1200)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]
  payouts    Payout[]

  @@index([status])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  products    Product[]
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  imageUrl String?
  parentId String?
  position Int     @default(0)
  isActive Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id              String                       @id @default(cuid())
  sellerId        String
  categoryId      String
  brandId         String?
  title           String
  slug            String                       @unique
  description     String
  highlights      String[]                     @default([])
  /// minor units (paise)
  price           Int
  compareAtPrice  Int?
  currency        String                       @default("INR")
  taxBps          Int                          @default(500)
  status          ProductStatus                @default(DRAFT)
  rating          Float                        @default(0)
  ratingCount     Int                          @default(0)
  soldCount       Int                          @default(0)
  /// free-form spec bag: { material, colour, dimensions, ... }
  attributes      Json                         @default("{}")
  shippingDaysMin Int                          @default(2)
  shippingDaysMax Int                          @default(6)
  isReturnable    Boolean                      @default(true)
  /// semantic representation of title + description + images
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  seller             Seller              @relation(fields: [sellerId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  reviews            Review[]
  reviewSummary      ReviewSummary?
  postTags           PostProductTag[]
  wishlistedBy       WishlistItem[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  priceSnapshots     PriceSnapshot[]
  forecasts          PriceForecast[]
  inventory          StoreInventory[]
  substitutions      SmartSubstitution[] @relation("SubstitutionOriginal")
  substituteFor      SmartSubstitution[] @relation("SubstitutionReplacement")
  affiliateLinks     AffiliateLink[]
  reorderSuggestions ReorderSuggestion[]
  boardItems         BoardItem[]
  returnItems        ReturnRequest[]

  @@index([categoryId, status])
  @@index([sellerId])
  @@index([price])
  @@index([soldCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  name           String
  /// { size: "M", colour: "onyx" }
  attributes     Json     @default("{}")
  price          Int
  compareAtPrice Int?
  stock          Int      @default(0)
  weightGrams    Int?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  inventory  StoreInventory[]
  postTags   PostProductTag[]

  @@index([productId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  authorId     String
  orderItemId  String?  @unique
  rating       Int
  title        String?
  body         String?
  media        String[] @default([])
  helpfulCount Int      @default(0)
  isVerified   Boolean  @default(false)
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([authorId])
}

/// Generated by the review-summarisation worker (Phase 6).
model ReviewSummary {
  id          String   @id @default(cuid())
  productId   String   @unique
  summary     String
  pros        String[] @default([])
  cons        String[] @default([])
  sentiment   Float    @default(0)
  reviewCount Int      @default(0)
  model       String?
  generatedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceSnapshot {
  id             String   @id @default(cuid())
  productId      String
  price          Int
  compareAtPrice Int?
  capturedAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

model PriceForecast {
  id             String   @id @default(cuid())
  productId      String
  horizonDays    Int
  predictedPrice Int
  confidence     Float
  generatedAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, horizonDays, generatedAt])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

// =============================================================================
// Social: posts, reels, pins, stories, follows, comments, DMs
// =============================================================================

enum PostType {
  POST
  REEL
  PIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

model Post {
  id           String                       @id @default(cuid())
  authorId     String
  type         PostType                     @default(POST)
  caption      String?
  locationName String?
  lat          Float?
  lng          Float?
  visibility   Visibility                   @default(PUBLIC)
  likeCount    Int                          @default(0)
  commentCount Int                          @default(0)
  saveCount    Int                          @default(0)
  viewCount    Int                          @default(0)
  shareCount   Int                          @default(0)
  isShoppable  Boolean                      @default(true)
  embedding    Unsupported("vector(1536)")?
  publishedAt  DateTime                     @default(now())
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  productTags PostProductTag[]
  likes       PostLike[]
  comments    Comment[]
  saves       SavedPost[]
  boardItems  BoardItem[]
  impressions FeedImpression[]

  @@index([authorId, publishedAt])
  @@index([type, publishedAt])
  @@index([publishedAt])
}

model PostMedia {
  id         String    @id @default(cuid())
  postId     String
  type       MediaType @default(IMAGE)
  url        String
  thumbUrl   String?
  width      Int?
  height     Int?
  durationMs Int?
  position   Int       @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}

/// A shoppable hotspot on a post/reel: normalised coordinates + timecode.
model PostProductTag {
  id        String   @id @default(cuid())
  postId    String
  productId String
  variantId String?
  label     String?
  /// 0..1 from the left/top of the media frame
  x         Float    @default(0.5)
  y         Float    @default(0.5)
  /// millisecond offset inside a reel
  atMs      Int?
  createdAt DateTime @default(now())

  post    Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([postId, productId, x, y])
  @@index([productId])
}

model Story {
  id        String    @id @default(cuid())
  authorId  String
  mediaUrl  String
  mediaType MediaType @default(IMAGE)
  caption   String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  likeCount Int      @default(0)
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentThread")
  likes   CommentLike[]

  @@index([postId, createdAt])
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model SavedPost {
  postId    String
  userId    String
  boardId   String?
  createdAt DateTime @default(now())

  post  Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board? @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

enum ConversationType {
  DIRECT
  GROUP
  SUPPORT
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(DIRECT)
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  role           String    @default("MEMBER")
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String?
  mediaUrl       String?
  type           String    @default("TEXT")
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// =============================================================================
// Discovery: boards, pins, trends
// =============================================================================

model Board {
  id              String   @id @default(cuid())
  ownerId         String
  title           String
  slug            String?  @unique
  description     String?
  isPrivate       Boolean  @default(false)
  isCollaborative Boolean  @default(false)
  itemCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators BoardCollaborator[]
  items         BoardItem[]
  savedPosts    SavedPost[]

  @@index([ownerId, updatedAt])
}

model BoardCollaborator {
  boardId   String
  userId    String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

/// A board can hold either a saved post (inspiration) or a product (intent).
model BoardItem {
  id        String   @id @default(cuid())
  boardId   String
  postId    String?
  productId String?
  addedById String?
  note      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedBy User?    @relation("BoardItemAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([boardId, position])
  @@index([productId])
}

model TrendingTopic {
  id          String   @id @default(cuid())
  label       String
  slug        String
  score       Float    @default(0)
  windowStart DateTime
  windowEnd   DateTime

  @@unique([slug, windowStart])
  @@index([score])
}

// =============================================================================
// Cart, orders, payments, returns
// =============================================================================

enum FulfillmentMode {
  QUICK
  MARKETPLACE
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model Cart {
  id        String          @id @default(cuid())
  userId    String
  mode      FulfillmentMode @default(MARKETPLACE)
  storeId   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    DarkStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items    CartItem[]
  couponId String?
  coupon   Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@unique([userId, mode])
}

model CartItem {
  id          String          @id @default(cuid())
  cartId      String
  productId   String
  variantId   String?
  quantity    Int             @default(1)
  /// price locked at add-to-cart time (minor units)
  unitPrice   Int
  fulfillment FulfillmentMode @default(MARKETPLACE)
  createdAt   DateTime        @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([productId])
}

model Order {
  id              String          @id @default(cuid())
  userId          String
  mode            FulfillmentMode @default(MARKETPLACE)
  status          OrderStatus     @default(PENDING)
  storeId         String?
  subtotal        Int
  discount        Int             @default(0)
  deliveryFee     Int             @default(0)
  tax             Int             @default(0)
  total           Int
  currency        String          @default("INR")
  couponId        String?
  /// immutable address snapshot at checkout
  addressSnapshot Json
  cancelReason    String?
  placedAt        DateTime        @default(now())
  deliveredAt     DateTime?
  updatedAt       DateTime        @updatedAt

  user        User                @relation(fields: [userId], references: [id])
  store       DarkStore?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  coupon      Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  events      OrderEvent[]
  payment     Payment?
  shipment    Shipment?
  delivery    DeliveryAssignment?
  redemptions CouponRedemption[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([storeId])
}

enum OrderItemStatus {
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  sellerId    String?
  /// title/variant snapshot so history survives catalogue edits
  title       String
  variantName String?
  quantity    Int
  unitPrice   Int
  total       Int
  status      OrderItemStatus @default(PLACED)
  createdAt   DateTime        @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller  Seller?         @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  review  Review?
  return  ReturnRequest?

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String          @unique
  provider    PaymentProvider
  providerRef String?         @unique
  amount      Int
  currency    String          @default("INR")
  status      PaymentStatus   @default(PENDING)
  method      String?
  failureCode String?
  capturedAt  DateTime?
  rawPayload  Json?
  createdAt   DateTime        @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]
}

model Refund {
  id          String    @id @default(cuid())
  paymentId   String
  orderItemId String?
  amount      Int
  reason      String?
  status      String    @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

enum CouponType {
  PERCENT
  FLAT
  FREE_DELIVERY
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int
  minSpend    Int        @default(0)
  maxDiscount Int?
  scope       String     @default("ALL")
  startsAt    DateTime   @default(now())
  expiresAt   DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)

  carts       Cart[]
  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKED_UP
  REFUNDED
  REJECTED
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderItemId  String       @unique
  userId       String
  productId    String
  reason       String
  description  String?
  media        String[]     @default([])
  status       ReturnStatus @default(REQUESTED)
  refundAmount Int?
  pickupAt     DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([userId, createdAt])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  carrier        String
  trackingNumber String?   @unique
  status         String    @default("CREATED")
  dispatchedAt   DateTime?
  etaAt          DateTime?
  deliveredAt    DateTime?
  events         Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// =============================================================================
// Quick commerce: dark stores, inventory, riders, live delivery
// =============================================================================

model DarkStore {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String
  city      String
  pincode   String
  lat       Float
  lng       Float
  radiusKm  Float    @default(2.5)
  capacity  Int      @default(4000)
  isActive  Boolean  @default(true)
  opensAt   String   @default("06:00")
  closesAt  String   @default("02:00")
  createdAt DateTime @default(now())

  inventory     StoreInventory[]
  orders        Order[]
  carts         Cart[]
  substitutions SmartSubstitution[]

  @@index([city, isActive])
}

model StoreInventory {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  variantId         String?
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  restockEtaMinutes Int?
  /// store-level price override in minor units (promos)
  priceOverride     Int?
  aisle             String?
  updatedAt         DateTime @updatedAt

  store   DarkStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([storeId, productId, variantId])
  @@index([productId])
}

/// Pre-computed substitutes for out-of-stock quick-commerce items.
model SmartSubstitution {
  id                  String  @id @default(cuid())
  storeId             String
  originalProductId   String
  substituteProductId String
  score               Float   @default(0)
  reason              String?
  isActive            Boolean @default(true)

  store      DarkStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  original   Product   @relation("SubstitutionOriginal", fields: [originalProductId], references: [id], onDelete: Cascade)
  substitute Product   @relation("SubstitutionReplacement", fields: [substituteProductId], references: [id], onDelete: Cascade)

  @@unique([storeId, originalProductId, substituteProductId])
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  ASSIGNED
  ON_DELIVERY
  PAUSED
}

model Rider {
  id              String      @id @default(cuid())
  userId          String      @unique
  vehicle         String      @default("BIKE")
  licenseNumber   String?
  status          RiderStatus @default(OFFLINE)
  rating          Float       @default(0)
  deliveriesCount Int         @default(0)
  currentLat      Float?
  currentLng      Float?
  lastPingAt      DateTime?
  createdAt       DateTime    @default(now())

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments DeliveryAssignment[]

  @@index([status])
}

enum DeliveryStatus {
  ASSIGNED
  PICKING
  PICKED_UP
  EN_ROUTE
  DELIVERED
  FAILED
}

model DeliveryAssignment {
  id            String         @id @default(cuid())
  orderId       String         @unique
  riderId       String
  status        DeliveryStatus @default(ASSIGNED)
  distanceKm    Float?
  etaMinutes    Int?
  /// GeoJSON LineString for the rendered route
  routeGeometry Json?
  currentLat    Float?
  currentLng    Float?
  assignedAt    DateTime       @default(now())
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  proofPhotoUrl String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId, status])
}

// =============================================================================
// Creators, affiliates, payouts, analytics
// =============================================================================

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  niche           String?
  about           String?
  isAffiliate     Boolean  @default(false)
  affiliateCode   String?  @unique
  followerCount   Int      @default(0)
  totalEarnings   Int      @default(0)
  monthlyEarnings Int      @default(0)
  createdAt       DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateLinks AffiliateLink[]
}

model AffiliateLink {
  id          String   @id @default(cuid())
  creatorId   String
  productId   String
  code        String   @unique
  clicks      Int      @default(0)
  conversions Int      @default(0)
  gmv         Int      @default(0)
  earnings    Int      @default(0)
  createdAt   DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([creatorId, earnings])
}

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id          String       @id @default(cuid())
  userId      String
  sellerId    String?
  amount      Int
  currency    String       @default("INR")
  status      PayoutStatus @default(SCHEDULED)
  periodStart DateTime
  periodEnd   DateTime
  reference   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

enum InteractionType {
  VIEW
  IMPRESSION
  LIKE
  SAVE
  SHARE
  COMMENT
  PRODUCT_TAP
  ADD_TO_CART
  PURCHASE
  SEARCH
}

/// Behaviour log that trains the "For You" ranker. Append-only.
model AnalyticsEvent {
  id         String          @id @default(cuid())
  actorId    String?
  sessionId  String
  type       InteractionType
  entityType String
  entityId   String?
  surface    String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model FeedImpression {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  surface   String   @default("for_you")
  position  Int
  dwellMs   Int      @default(0)
  clicked   Boolean  @default(false)
  saved     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([postId])
}

model SearchQuery {
  id               String   @id @default(cuid())
  userId           String?
  rawQuery         String
  normalized       String
  resultCount      Int      @default(0)
  clickedProductId String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([normalized, createdAt])
}

// =============================================================================
// AI: assistant threads, visual search, reorder suggestions
// =============================================================================

enum AssistantRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model AssistantThread {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id              String        @id @default(cuid())
  threadId        String
  role            AssistantRole
  content         String
  /// tool invocations + retrieved product ids, for debugging / evals
  toolCalls       Json?
  recommendations Json?
  tokenCount      Int?
  createdAt       DateTime      @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model VisualSearchRequest {
  id            String   @id @default(cuid())
  userId        String?
  imageUrl      String
  topProductIds String[] @default([])
  confidence    Float?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ReorderSuggestion {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  cadenceDays Int
  nextOrderAt DateTime
  confidence  Float    @default(0)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, nextOrderAt])
}

// =============================================================================
// Trust & safety: reports, risk signals
// =============================================================================

enum ReportTargetType {
  POST
  COMMENT
  USER
  PRODUCT
  SELLER
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String?
  targetType  ReportTargetType
  targetId    String
  reason      String
  details     String?
  status      ReportStatus     @default(OPEN)
  moderatorId String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())

  reporter  User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  moderator User? @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// Heuristic fraud / spam score attached to any subject.
model RiskSignal {
  id          String   @id @default(cuid())
  subjectType String
  subjectId   String
  signal      String
  score       Float    @default(0)
  status      String   @default("OPEN")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([status, createdAt])
}
