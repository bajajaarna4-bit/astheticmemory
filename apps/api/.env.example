# ---------------------------------------------------------------------------
# VELORA API — copy to apps/api/.env and fill in as phases land.
# Phase 1 only needs DATABASE_URL for the readiness probe.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL with the pgvector extension enabled.
DATABASE_URL="postgresql://velora:velora@localhost:5432/velora?schema=public"

# Optional until Phase 5 (ETA cache, queues, live tracking fan-out).
# REDIS_URL="redis://localhost:6379"

# Auth (Phase 2). Replace both secrets before any shared deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Payments (Phase 4)
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Maps (Phase 5)
# MAPBOX_TOKEN=

# Intelligence (Phase 6)
# OPENAI_API_KEY=
